{
  "manifest_version": 2,
  "name": "Tab Volume Normalizer",
  "version": "1.0.0",
  "description": "Click the toolbar button to turn audio volume normalization on or off for the current tab.",
  "icons": {
    "48": "icons/on.svg",
    "96": "icons/on.svg"
  },
  "permissions": [
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": "icons/off.svg",
    "default_title": "Volume normalization: off (click to turn on)"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-volume-normalizer@koconnorgit",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/koconnorgit/tab-volume-normalizer/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
